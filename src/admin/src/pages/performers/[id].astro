---
import { EditableForm } from '../../components/performer/EditableForm';
import Layout from '../../layouts/Layout.astro';
import { client } from '../../utils/client';

export const prerender = false;

interface Props {
  id: string;
}

const { id } = Astro.params;

if (typeof id !== 'string') {
  // TODO ちゃんとしたハンドリングをする
  throw new Error('URL が不正');
}

const { data, status } = await client.api.performers({ performerId: id }).get({
  headers: {
    'x-csrf-token': Astro.cookies.get('csrf')?.value ?? '',
    'cookie': Astro.request.headers.get('cookie') ?? '',
  },
});

if (status === 401) {
  return Astro.redirect('/auth/login');
}
---

<Layout pageTitle="共演者詳細">
  <div>
    <EditableForm data={data ?? undefined} status={status} client:only="solid-js" />
  </div>
</Layout>
