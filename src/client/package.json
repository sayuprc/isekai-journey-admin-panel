{
  "name": "client",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "style": "stylelint '**/*.{css,astro}'",
    "style:fix": "stylelint '**/*.{css,astro}' --fix",
    "tcm": "tcm -p 'src/styles/*.module.css' .",
    "tcm:watch": "tcm -w -p 'src/styles/*.module.css' .",
    "generate:api": "openapi-typescript ../contracts/generated/oas/openapi.yaml -o ./src/generated/schema.d.ts",
    "prism": "prism mock ../contracts/generated/oas/openapi.yaml -h 0.0.0.0"
  },
  "dependencies": {
    "@astrojs/solid-js": "^5.1.3",
    "@tailwindcss/vite": "^4.1.17",
    "astro": "^5.16.3",
    "daisyui": "^5.5.5",
    "openapi-fetch": "^0.15.0",
    "tailwindcss": "^4.1.17"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@stoplight/prism-cli": "^5.14.2",
    "@stylistic/eslint-plugin": "^5.6.1",
    "@stylistic/stylelint-plugin": "^4.0.0",
    "@typescript-eslint/parser": "^8.48.0",
    "eslint": "^9.39.1",
    "eslint-plugin-astro": "^1.5.0",
    "eslint-plugin-import": "^2.32.0",
    "openapi-typescript": "^7.10.1",
    "postcss-html": "^1.8.0",
    "stylelint": "^16.26.1",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-recess-order": "^7.4.0",
    "stylelint-config-standard": "^39.0.1",
    "stylelint-order": "^7.0.0",
    "typed-css-modules": "^0.9.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0"
  }
}
