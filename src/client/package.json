{
  "name": "client",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "style": "stylelint '**/*.{css,astro}'",
    "style:fix": "stylelint '**/*.{css,astro}' --fix",
    "tcm": "tcm -p 'src/styles/*.module.css' .",
    "tcm:watch": "tcm -w -p 'src/styles/*.module.css' .",
    "generate:api": "openapi-typescript ../contracts/generated/oas/openapi.yaml -o ./src/generated/schema.d.ts",
    "prism": "prism mock ../contracts/generated/oas/openapi.yaml"
  },
  "dependencies": {
    "@astrojs/solid-js": "^5.1.0",
    "@tailwindcss/vite": "^4.1.10",
    "astro": "^5.10.0",
    "daisyui": "^5.0.43",
    "openapi-fetch": "^0.14.0",
    "tailwindcss": "^4.1.10"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@stoplight/prism-cli": "^5.14.2",
    "@stylistic/eslint-plugin": "^4.4.1",
    "@stylistic/stylelint-plugin": "^3.1.2",
    "@typescript-eslint/parser": "^8.34.1",
    "eslint": "^9.29.0",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-import": "^2.31.0",
    "openapi-typescript": "^7.8.0",
    "postcss-html": "^1.8.0",
    "stylelint": "^16.21.0",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-recess-order": "^7.1.0",
    "stylelint-config-standard": "^38.0.0",
    "stylelint-order": "^7.0.0",
    "typed-css-modules": "^0.9.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.1"
  }
}
