---
import { EditableForm } from '../../components/creator/EditableForm';
import Layout from '../../layouts/Layout.astro';
import { client } from '../../utils/client';

export const prerender = false;

interface Props {
  id: string;
}

const { id } = Astro.params;

if (typeof id !== 'string') {
  // TODO ちゃんとしたハンドリングをする
  throw new Error('URL が不正');
}

const { data, response } = await client.api.creators({ creatorId: id }).get({
  headers: {
    'x-csrf-token': Astro.cookies.get('csrf')?.value ?? '',
    'cookie': Astro.request.headers.get('cookie') ?? '',
  },
});

if (!data) {
  // 適切なエラーハンドリング
  throw new Error();
}
---

<Layout pageTitle="クリエイター詳細">
  <div>
    <EditableForm data={data} status={response.status} client:load />
  </div>
</Layout>
