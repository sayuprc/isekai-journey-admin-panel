---
import { EditableForm } from '../../components/performer/EditableForm';
import Layout from '../../layouts/Layout.astro';
import { createClient } from '../../utils/client';

export const prerender = false;

interface Props {
  id: string;
}

const { id } = Astro.params;

if (typeof id !== 'string') {
  // TODO ちゃんとしたハンドリングをする
  throw new Error('URL が不正');
}

const { data, response } = await createClient(Astro.request).GET('/performers/{performerId}', {
  params: {
    path: { performerId: id },
  },
});
---

<Layout pageTitle="共演者詳細">
  <div>
    <EditableForm data={data} status={response.status} client:load />
  </div>
</Layout>
