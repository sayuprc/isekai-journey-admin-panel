---
import createClient from 'openapi-fetch';
import type { paths } from '../../generated/schema';
import Layout from '../../layouts/Layout.astro';

const client = createClient<paths>({ baseUrl: import.meta.env.API_URL });

const { data } = await client.GET('/song-types');

if (data == null) {
  throw new Error();
}
---

<Layout pageTitle="楽曲種別一覧">
  <div class="h-full overflow-x-auto">
    <table class="table table-pin-rows table-zebra">
      <thead>
        <tr>
          <th>楽曲種別名</th>
          <th>表示順</th>
          <th>操作</th>
        </tr>
      </thead>
      <tbody>
        {
          data.songTypes.map((songType) => {
            return (
              <tr>
                <td>{songType.songTypeName}</td>
                <td>{songType.orderNo}</td>
                <td>
                  <a href={`/song-types/${songType.songTypeId}`}>編集</a>
                </td>
              </tr>
            );
          })
        }
      </tbody>
    </table>
  </div>
</Layout>
