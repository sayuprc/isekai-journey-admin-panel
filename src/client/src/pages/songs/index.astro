---
import { FlashMessage } from '../../components/Flash';
import Layout from '../../layouts/Layout.astro';
import { createClient } from '../../utils/client';

export const prerender = false;

const { data } = await createClient(Astro.request).GET('/songs');

if (!data) {
  throw new Error();
}
---

<Layout pageTitle="楽曲一覧">
  <FlashMessage client:only="solid-js" />
  <!-- TODO コンポーネント化する -->
  <div class="h-full overflow-x-auto">
    <table class="table table-pin-rows table-zebra">
      <thead>
        <tr>
          <th>楽曲名</th>
          <th>楽曲種別</th>
          <th>表示順</th>
          <th>操作</th>
        </tr>
      </thead>
      <tbody>
        {
          data.songs.map((song) => {
            return (
              <tr>
                <td>{song.title}</td>
                <td>{song.songType.name}</td>
                <td>{song.orderNo}</td>
                <td>
                  <a href={`/songs/${song.songId}`}>編集</a>
                </td>
              </tr>
            );
          })
        }
      </tbody>
    </table>
  </div>
</Layout>
