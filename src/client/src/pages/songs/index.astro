---
import { FlashMessage } from '../../components/Flash';
import Layout from '../../layouts/Layout.astro';
import { client } from '../../utils/client';

export const prerender = false;

const { data } = await client.api.songs.get({
  headers: {
    'x-csrf-token': Astro.cookies.get('csrf')?.value ?? '',
    'cookie': Astro.request.headers.get('cookie') ?? '',
  },
});

if (!data) {
  throw new Error();
}
---

<Layout pageTitle="楽曲一覧">
  <FlashMessage client:only="solid-js" />
  <div class="mb-4 flex justify-end">
    <a href="/songs/create" class="btn btn-primary btn-sm">新規作成</a>
  </div>
  <!-- TODO コンポーネント化する -->
  <div class="rounded-box border border-base-300 bg-base-100 overflow-x-auto">
    <table class="table table-zebra">
      <thead>
        <tr>
          <th>楽曲名</th>
          <th>楽曲種別</th>
          <th>説明</th>
          <th>表示順</th>
          <th>操作</th>
        </tr>
      </thead>
      <tbody>
        {
          data.songs.map((song) => {
            return (
              <tr>
                <td>{song.title}</td>
                <td>{song.songType.name}</td>
                <td>{song.description}</td>
                <td>{song.orderNo}</td>
                <td>
                  <a href={`/songs/${song.songId}`} class="btn btn-ghost btn-xs">編集</a>
                </td>
              </tr>
            );
          })
        }
      </tbody>
    </table>
  </div>
</Layout>
