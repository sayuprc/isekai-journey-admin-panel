{
    "name": "sayuprc/isekai-journey-admin-panel",
    "type": "project",
    "description": "Management screen for journey of Isekaijoucho.",
    "keywords": ["isekaijoucho"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-grpc": "*",
        "cuyz/valinor": "^1.14",
        "grpc/grpc": "^1.57",
        "jeroennoten/laravel-adminlte": "^3.15",
        "laravel/framework": "^12.0",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.10"
    },
    "require-dev": {
        "askdkc/breezejp": "^2.3",
        "barryvdh/laravel-ide-helper": "^3.5",
        "brianium/paratest": "^7.8",
        "fakerphp/faker": "^1.24",
        "infection/infection": "^0.29",
        "larastan/larastan": "^3.0",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.7",
        "phparkitect/phparkitect": "^0.5.2",
        "phpunit/phpunit": "^11.5",
        "symplify/easy-coding-standard": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Generated\\": "Generated/",
            "Auth\\": "packages/Auth/",
            "JourneyLog\\": "packages/JourneyLog/",
            "JourneyLogLinkType\\": "packages/JourneyLogLinkType/",
            "Support\\": "packages/Support/",
            "Song\\": "packages/Song/",
            "SongType\\": "packages/SongType/",
            "Creator\\": "packages/Creator/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "phpstan": "phpstan analyse --memory-limit=-1 --no-progress",
        "phpstan-clear-cache": "phpstan clear-result-cache",
        "arkitect": "phparkitect check",
        "ecs": "vendor/bin/ecs check --ansi --no-progress-bar",
        "ecs-fix": "vendor/bin/ecs check --fix --ansi --no-progress-bar",
        "test-all": "paratest",
        "test-unit": "paratest tests/Unit",
        "test-feature": "paratest tests/Feature",
        "coverage": "php artisan test --env=testing --coverage-html=\"reports/coverage\"",
        "infection": "infection --threads=4",
        "ide-gen": "php artisan ide-helper:generate",
        "ide-model": "php artisan ide-helper:models -W",
        "ide-meta": "php artisan ide-helper:meta"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true,
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
