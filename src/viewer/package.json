{
  "name": "viewer",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "style": "stylelint '**/*.{css,astro}'",
    "style:fix": "stylelint '**/*.{css,astro}' --fix",
    "proto:generate": "grpc_tools_node_protoc --js_out=import_style=commonjs,binary:./generated --grpc_out=grpc_js:./generated --plugin=protoc-gen-grpc=./node_modules/.bin/grpc_tools_node_protoc_plugin --ts_out=grpc_js:./generated -I ./proto/journey_log ./proto/journey_log/journey_log.proto",
    "tcm": "tcm -p 'src/styles/*.module.css' .",
    "tcm:watch": "tcm -w -p 'src/styles/*.module.css' ."
  },
  "dependencies": {
    "@astrojs/solid-js": "^5.0.7",
    "astro": "^5.12.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@stylistic/eslint-plugin": "^5.2.3",
    "@stylistic/stylelint-plugin": "^4.0.0",
    "@typescript-eslint/parser": "^8.39.0",
    "eslint": "^9.33.0",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-import": "^2.32.0",
    "grpc_tools_node_protoc_ts": "^5.3.3",
    "grpc-tools": "^1.13.0",
    "postcss-html": "^1.8.0",
    "stylelint": "^16.23.1",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-recess-order": "^7.1.0",
    "stylelint-config-standard": "^39.0.0",
    "stylelint-order": "^7.0.0",
    "typed-css-modules": "^0.9.1",
    "typescript-eslint": "^8.39.0"
  }
}
