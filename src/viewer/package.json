{
  "name": "viewer",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "wrangler deploy",
    "astro": "astro",
    "format": "biome format --write",
    "format:check": "biome format",
    "lint": "eslint --fix",
    "lint:check": "eslint",
    "style": "stylelint '**/*.{css,astro}' --fix",
    "style:check": "stylelint '**/*.{css,astro}'",
    "tcm": "tcm -p 'src/styles/*.module.css' .",
    "tcm:watch": "tcm -w -p 'src/styles/*.module.css' .",
    "generate:api": "openapi-ts"
  },
  "dependencies": {
    "@astrojs/solid-js": "catalog:astro",
    "@tailwindcss/vite": "catalog:ui",
    "astro": "catalog:astro",
    "daisyui": "catalog:ui",
    "solid-js": "catalog:astro",
    "tailwindcss": "catalog:ui",
    "wrangler": "4.98.0"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:lint",
    "@eslint/js": "catalog:lint",
    "@hey-api/openapi-ts": "catalog:gen",
    "@stylistic/eslint-plugin": "catalog:lint",
    "@stylistic/stylelint-plugin": "catalog:lint",
    "@types/bun": "catalog:",
    "@typescript-eslint/parser": "catalog:lint",
    "eslint": "catalog:lint",
    "eslint-plugin-astro": "catalog:lint",
    "eslint-plugin-import": "catalog:lint",
    "postcss-html": "catalog:lint",
    "stylelint": "catalog:lint",
    "stylelint-config-html": "catalog:lint",
    "stylelint-config-recess-order": "catalog:lint",
    "stylelint-config-standard": "catalog:lint",
    "stylelint-order": "catalog:lint",
    "typed-css-modules": "catalog:gen",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:lint"
  }
}
