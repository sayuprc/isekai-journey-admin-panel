---
import { isActivePath, navLinks } from '../../data/site-helpers';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
---

<nav class="site-nav">
  <div class="nav-inner">
    <a class="brand" href="/">
      <img src="/logo-dark.svg" alt="" class="brand-logo brand-logo-dark" />
      <img src="/logo-light.svg" alt="" class="brand-logo brand-logo-light" />
      <div class="brand-text">
        <span class="brand-mark">ヰ世界観測所</span>
        <span class="brand-en">Isekai Observatory</span>
      </div>
    </a>
    <div class="nav-links">
      {
        navLinks.map(link => (
          <a href={link.href} class={isActivePath(currentPath, link.href) ? 'active' : undefined}>
            {link.label}
          </a>
        ))
      }
    </div>
    <div class="nav-utils">
      <button class="icon-btn" type="button" title="テーマ切替" data-theme-toggle>☼</button>
      <button class="icon-btn" type="button" title="パレット切替" data-palette-toggle>◈</button>
    </div>
  </div>
</nav>
