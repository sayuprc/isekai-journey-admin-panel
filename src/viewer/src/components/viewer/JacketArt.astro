---
import { assetImageSrcset } from '../../shared/image';

interface Props {
  imageUrl?: string | null;
  color?: string;
  label: string;
  aspectRatio?: string;
  /** ファーストビューに入る画像だけ eager にする。遅延したままだと LCP が伸びる */
  loading?: 'lazy' | 'eager';
  /** 表示枠の幅。既定は枠が不明な場合の安全側 */
  sizes?: string;
}

const { imageUrl = null, color = 'var(--accent)', label, aspectRatio = '1 / 1', loading = 'lazy', sizes = '100vw' } = Astro.props;

// 詳細の 160px 枠から一覧の 1 カラム表示まで、実際に使われる表示幅をまたぐ段
const WIDTHS = [160, 320, 480, 720, 960];

const srcset = imageUrl === null ? undefined : assetImageSrcset(imageUrl, WIDTHS);
---

{
  imageUrl
    ? (
        <img
          class="jacket-art jacket-art-image"
          style={`--tile-aspect:${aspectRatio};aspect-ratio:var(--tile-aspect);width:100%;object-fit:cover;`}
          src={imageUrl}
          srcset={srcset}
          sizes={srcset === undefined ? undefined : sizes}
          loading={loading}
          fetchpriority={loading === 'eager' ? 'high' : undefined}
          decoding="async"
          alt={label}
        />
      )
    : (
        <div class="jacket-art" style={`--tile-color:${color};--tile-aspect:${aspectRatio};`}>
          <div class="jacket-art-label">{label}</div>
          <svg class="jacket-art-mark" viewBox="0 0 100 100" aria-hidden="true">
            <circle cx="50" cy="50" r="30" fill="none" stroke="white" stroke-width="0.3" />
            <circle cx="50" cy="50" r="40" fill="none" stroke="white" stroke-width="0.2" />
            <circle cx="50" cy="50" r="20" fill="none" stroke="white" stroke-width="0.4" />
            <line x1="50" y1="10" x2="50" y2="90" stroke="white" stroke-width="0.2" />
            <line x1="10" y1="50" x2="90" y2="50" stroke="white" stroke-width="0.2" />
          </svg>
        </div>
      )
}
