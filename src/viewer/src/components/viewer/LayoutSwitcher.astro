---
interface Option {
  value: string;
  label: string;
}

interface Props {
  name: string;
  options: Option[];
  initialValue: string;
}

const { name, options, initialValue } = Astro.props;
const storageKey = `viewer-layout-${name}`;
---

<div class="seg" data-layout-switcher={name} data-layout-storage={storageKey} data-layout-default={initialValue}>
  {
    options.map(option => (
      <button
        type="button"
        data-layout-option={option.value}
        class={option.value === initialValue ? 'active' : undefined}
        title={option.label}
        aria-label={option.label}
      >
        {
          option.value === 'grid' && (
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <rect x="2" y="2" width="5" height="5"></rect>
              <rect x="9" y="2" width="5" height="5"></rect>
              <rect x="2" y="9" width="5" height="5"></rect>
              <rect x="9" y="9" width="5" height="5"></rect>
            </svg>
          )
        }
        {
          option.value === 'table' && (
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <rect x="2" y="3" width="12" height="10"></rect>
              <line x1="2" y1="6.5" x2="14" y2="6.5"></line>
              <line x1="2" y1="9.5" x2="14" y2="9.5"></line>
              <line x1="6.5" y1="3" x2="6.5" y2="13"></line>
            </svg>
          )
        }
        {
          option.value === 'card' && (
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <rect x="2" y="2" width="12" height="12"></rect>
              <rect x="4" y="4" width="8" height="4" class="seg-fill"></rect>
              <line x1="4" y1="10" x2="12" y2="10"></line>
              <line x1="4" y1="12" x2="9" y2="12"></line>
            </svg>
          )
        }
        {
          option.value === 'cinema' && (
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <rect x="2" y="3.5" width="12" height="9"></rect>
              <path d="M7 6.5 L10.5 8 L7 9.5 Z" class="seg-fill"></path>
            </svg>
          )
        }
        {
          option.value === 'mosaic' && (
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <rect x="2" y="2" width="7" height="7"></rect>
              <rect x="10" y="2" width="4" height="4"></rect>
              <rect x="10" y="7" width="4" height="2"></rect>
              <rect x="2" y="10" width="4" height="4"></rect>
              <rect x="7" y="10" width="7" height="4"></rect>
            </svg>
          )
        }
        {
          option.value === 'list' && (
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <circle cx="3" cy="4" r=".7" class="seg-fill"></circle>
              <circle cx="3" cy="8" r=".7" class="seg-fill"></circle>
              <circle cx="3" cy="12" r=".7" class="seg-fill"></circle>
              <line x1="6" y1="4" x2="14" y2="4"></line>
              <line x1="6" y1="8" x2="14" y2="8"></line>
              <line x1="6" y1="12" x2="14" y2="12"></line>
            </svg>
          )
        }
      </button>
    ))
  }
</div>

<script is:inline>
  (() => {
    const initLayoutSwitchers = () => {
      const switchers = document.querySelectorAll('[data-layout-switcher]');

      for (const switcher of switchers) {
        if (!(switcher instanceof HTMLElement)) continue;
        if (switcher.dataset.layoutReady === 'true') continue;

        const name = switcher.dataset.layoutSwitcher;
        const storageKey = switcher.dataset.layoutStorage;
        const defaultValue = switcher.dataset.layoutDefault;
        if (!name || !storageKey || !defaultValue) continue;

        const buttons = [...switcher.querySelectorAll('[data-layout-option]')];
        const panels = [...document.querySelectorAll(`[data-layout-group="${name}"] [data-layout-panel]`)];
        const savedValue = localStorage.getItem(storageKey) ?? defaultValue;

        const apply = (value) => {
          for (const button of buttons) {
            if (!(button instanceof HTMLButtonElement)) continue;
            button.classList.toggle('active', button.dataset.layoutOption === value);
          }

          for (const panel of panels) {
            if (!(panel instanceof HTMLElement)) continue;
            panel.hidden = panel.dataset.layoutPanel !== value;
          }

          localStorage.setItem(storageKey, value);
        };

        apply(savedValue);

        switcher.addEventListener('click', (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;
          const button = target.closest('[data-layout-option]');
          if (!(button instanceof HTMLButtonElement)) return;
          const value = button.dataset.layoutOption;
          if (!value) return;
          apply(value);
        });

        switcher.dataset.layoutReady = 'true';
      }
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initLayoutSwitchers, { once: true });
    } else {
      initLayoutSwitchers();
    }
  })();
</script>
