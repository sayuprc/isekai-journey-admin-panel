---
interface Props {
  en: string;
  jp: string;
  count?: number;
}

const { en, jp, count } = Astro.props;
---

<div class="detail-section-head">
  <div>
    <span class="label-mono">{en}</span>
    <span class="detail-section-head-jp">{jp}</span>
  </div>
  {count !== undefined && <span class="detail-section-head-count">{count}</span>}
</div>
