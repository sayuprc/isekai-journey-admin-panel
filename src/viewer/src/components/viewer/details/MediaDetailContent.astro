---
import { youtubeThumbnailSrcset } from '../../../features/media/labels';
import type { MediaDetail } from '../../../features/media/types';

interface Props {
  media: MediaDetail;
}

const { media } = Astro.props;
const songs = media.songs;

const formatPublishedAt = (value: string): string =>
  new Date(value).toLocaleDateString('ja-JP', { year: 'numeric', month: '2-digit', day: '2-digit' });
---

<div class="detail-page-content media-detail-content">
  <a class="media-detail-thumbnail-link" href={media.url} target="_blank" rel="noopener noreferrer">
    {
      media.thumbnailUrl
        ? (
            <img
              class="media-detail-thumbnail"
              src={media.thumbnailUrl}
              srcset={youtubeThumbnailSrcset(media.thumbnailUrl)}
              sizes="(max-width: 720px) 100vw, 640px"
              loading="lazy"
              alt={media.title}
            />
          )
        : (
            <div class="media-detail-thumbnail media-detail-thumbnail-placeholder">
              <span class="media-detail-thumbnail-placeholder-label">{media.platform.name}</span>
            </div>
          )
    }
    <span class="media-detail-thumbnail-overlay">{media.platform.name} で開く ↗</span>
  </a>

  <div class="label-mono">
    {formatPublishedAt(media.publishedAt)} · {media.platform.name} · {media.format.name}
    {/* API に views が無いため未提供セクションとして雛形を残す */}
    {/* {entry.views ? ` · ${entry.views} views` : ''} */}
  </div>
  <h1 class="detail-title">{media.title}</h1>
  {/* API に description が無いため未提供セクションとして雛形を残す */}
  {/* {entry.description && <p class="detail-description" style="margin-top: 16px;">{entry.description}</p>} */}

  {
    songs.length > 0 && (
      <>
        <div style="display:flex;align-items:baseline;justify-content:space-between;padding-bottom:8px;margin-top:36px;margin-bottom:16px;border-bottom:1px solid var(--line);">
          <div>
            <span class="label-mono">SONGS</span>
            <span style="margin-left:12px;font-family:'Shippori Mincho',serif;font-size:14px;color:var(--fg);">関連楽曲</span>
          </div>
          <span style="font-family:Spectral,serif;font-size:18px;font-weight:500;color:var(--accent);">{songs.length}</span>
        </div>
        <div class="rel-list">
          {
            songs.map(song => (
              <a class="rel-chip" href={`/songs/${song.songId}`}>
                <div class="rel-copy">
                  <div class="rel-main">{song.title}</div>
                  <div class="label-mono" style=" margin-top: 2px;font-size: 10px;">{song.type.name}</div>
                </div>
                <span style="font-size:14px;color:var(--fg-faint);">→</span>
              </a>
            ))
          }
        </div>
      </>
    )
  }
</div>
