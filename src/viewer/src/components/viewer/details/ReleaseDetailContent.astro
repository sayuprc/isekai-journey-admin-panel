---
import type { ReleaseGroup } from '../../../features/releases/types';
import { representativeJacketArtUrl } from '../../../features/releases/types';
import JacketArt from '../JacketArt.astro';

interface Props {
  releaseGroup: ReleaseGroup;
}

const { releaseGroup } = Astro.props;
const jacketArtUrl = representativeJacketArtUrl(releaseGroup);
---

<div class="detail-page-content release-detail-content">
  <JacketArt imageUrl={jacketArtUrl} label={releaseGroup.title} />
  <div class="label-mono" style="margin-top: 28px;">{releaseGroup.firstReleasedOn} · {releaseGroup.type.name}</div>
  <h1 class="detail-title">{releaseGroup.title}</h1>
  {releaseGroup.description && <p class="detail-description" style="margin-top: 16px;">{releaseGroup.description}</p>}

  {
    releaseGroup.releases.map(release => (
      <details class="release-version">
        <summary class="release-version-summary">
          <div class="release-version-heading">
            <span class="label-mono">{release.releasedOn}</span>
            <span class="release-version-name">{release.name}</span>
          </div>
          <span class="label-mono">
            {release.media.map(medium => medium.format.name).join(' + ')}
          </span>
        </summary>
        <div class="release-version-body-shell">
          <div class="release-version-body">
            {release.description && <p class="detail-description release-version-description">{release.description}</p>}
            {
              release.media.map(medium => (
                <div class="release-medium">
                  {
                    release.media.length > 1 && (
                      <div class="label-mono release-medium-heading">
                        DISC {medium.position} · {medium.format.name}
                      </div>
                    )
                  }
                  {
                    medium.tracks.length > 0
                      ? (
                          <div class="rel-list">
                            {medium.tracks.map(track => (
                              track.isDisplay
                                ? (
                                    <a class="rel-chip" href={`/songs/${track.songId}`}>
                                      <span class="detail-index" style="min-width:28px;">{String(track.trackNo).padStart(2, '0')}</span>
                                      <div class="rel-copy">
                                        <div class="rel-main">{track.title}</div>
                                      </div>
                                      <span style="font-size:14px;color:var(--fg-faint);">→</span>
                                    </a>
                                  )
                                : (
                                    <div class="rel-chip" aria-disabled="true">
                                      <span class="detail-index" style="min-width:28px;">{String(track.trackNo).padStart(2, '0')}</span>
                                      <div class="rel-copy">
                                        <div class="rel-main">{track.title}</div>
                                      </div>
                                    </div>
                                  )
                            ))}
                          </div>
                        )
                      : (
                          <p class="detail-description">収録曲情報はありません。</p>
                        )
                  }
                </div>
              ))
            }
          </div>
        </div>
      </details>
    ))
  }
</div>
