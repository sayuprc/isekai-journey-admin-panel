---
import { Q } from '../../../data/site-helpers';
import JacketArt from '../JacketArt.astro';
import SectionHead from '../SectionHead.astro';

interface Props {
  release: {
    id: string;
    title: string;
    date: string;
    type: string;
    format: string;
    label?: string;
    description?: string;
    color: string;
  };
}

const { release } = Astro.props;
const songs = Q.songsOfRelease(release.id);
---

<div class="detail-page-content release-detail-content">
  <div class="detail-hero-grid">
    <JacketArt color={release.color} label={release.title} />
    <div>
      <div class="label-mono">{release.date} · {release.type} · {release.format}</div>
      <h1 class="detail-title">{release.title}</h1>
      <div class="detail-title-en">{release.label}</div>
      <p class="detail-description">{release.description ?? 'モックデータのリリース詳細です。'}</p>
      <div class="detail-meta-grid">
        <div><span class="label-mono">TYPE</span><strong>{release.type}</strong></div>
        <div><span class="label-mono">FORMAT</span><strong>{release.format}</strong></div>
        <div><span class="label-mono">DATE</span><strong>{release.date}</strong></div>
        <div><span class="label-mono">TRACKS</span><strong>{songs.length}</strong></div>
      </div>
    </div>
  </div>

  <SectionHead num="01" title="収録曲" titleEn="Track List" />
  <div class="rel-list">
    {
      songs.map((song, index) => (
        <a class="rel-chip" href={`/songs/${song.id}`}>
          <span class="detail-index">{String(index + 1).padStart(2, '0')}</span>
          <div class="color-block" style={`--tile-color:${song.color};`}></div>
          <div class="rel-copy">
            <div class="rel-main">{song.title}</div>
            <div class="label-mono">{song.duration} · {song.category}</div>
          </div>
          <span>→</span>
        </a>
      ))
    }
  </div>
</div>
