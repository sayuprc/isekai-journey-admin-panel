---
import { Q } from '../../../data/site-helpers';
import JacketArt from '../JacketArt.astro';
import SectionHead from '../SectionHead.astro';

interface Props {
  song: {
    id: string;
    title: string;
    titleEn: string;
    category: string;
    duration: string;
    composer: string;
    lyricist: string;
    arranger: string;
    description: string;
    color: string;
  };
}

const { song } = Astro.props;
const releases = Q.releasesOfSong(song.id);
const performances = Q.performancesOfSong(song.id).sort((a, b) => b.date.localeCompare(a.date));
const media = Q.mediaOfSong(song.id);
---

<div class="detail-page-content song-detail-content">
  <div class="detail-hero-grid">
    <JacketArt color={song.color} label={song.titleEn} />
    <div>
      <div class="label-mono">{Q.firstReleaseDateOfSong(song.id) ?? '—'} · {song.category} · {song.duration}</div>
      <h1 class="detail-title">{song.title}</h1>
      <div class="detail-title-en">{song.titleEn}</div>
      <p class="detail-description">{song.description}</p>
      <div class="detail-meta-grid">
        <div><span class="label-mono">COMPOSER</span><strong>{song.composer}</strong></div>
        <div><span class="label-mono">LYRICIST</span><strong>{song.lyricist}</strong></div>
        <div><span class="label-mono">ARRANGER</span><strong>{song.arranger}</strong></div>
        <div><span class="label-mono">CATEGORY</span><strong>{song.category}</strong></div>
      </div>
    </div>
  </div>

  <SectionHead num="01" title="収録リリース" titleEn="Releases" />
  <div class="rel-list">
    {
      releases.map(release => (
        <a class="rel-chip" href={`/releases/${release.id}`}>
          <div class="color-block" style={`--tile-color:${release.color};`}></div>
          <div class="rel-copy">
            <div class="rel-main">{release.title}</div>
            <div class="label-mono">{release.date} · {release.type}</div>
          </div>
          <span>→</span>
        </a>
      ))
    }
  </div>

  <SectionHead num="02" title="関連メディア" titleEn="Media" />
  <div class="rel-list">
    {
      media.map(entry => (
        <a class="rel-chip" href={`/media/${entry.id}`}>
          <div class="color-block" style={`--tile-color:${entry.color};`}></div>
          <div class="rel-copy">
            <div class="rel-main">{entry.title}</div>
            <div class="label-mono">{entry.date} · {entry.type}</div>
          </div>
          <span>→</span>
        </a>
      ))
    }
  </div>

  <SectionHead num="03" title="歌唱履歴" titleEn="Performances" />
  <div class="rel-list">
    {
      performances.map((performance) => {
        const event = Q.event(performance.eventId);
        return (
          <a class="rel-chip" href={`/events/${performance.eventId}`}>
            <div class="rel-copy">
              <div class="rel-main">{event?.title ?? '—'}</div>
              <div class="label-mono">{performance.date} · {event?.category ?? ''}{performance.note ? ` · ${performance.note}` : ''}</div>
            </div>
            <span>→</span>
          </a>
        );
      })
    }
  </div>
</div>
