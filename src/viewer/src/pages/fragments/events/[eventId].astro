---
import EventDetailContent from '../../../components/viewer/details/EventDetailContent.astro';
import { SITE_DATA } from '../../../data/site-helpers';

export const partial = true;

export function getStaticPaths() {
  return SITE_DATA.events.map(event => ({ params: { eventId: event.id }, props: { event } }));
}

const { event } = Astro.props;
---

<EventDetailContent event={event} />
