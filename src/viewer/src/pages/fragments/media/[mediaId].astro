---
import MediaDetailContent from '../../../components/viewer/details/MediaDetailContent.astro';
import { mediaRepository } from '../../../features/media/api';

export const partial = true;

export async function getStaticPaths() {
  return Promise.all(
    (await mediaRepository.all()).map(async media => ({
      params: { mediaId: media.mediaId },
      props: { media: await mediaRepository.get(media.mediaId) },
    })),
  );
}

const { media } = Astro.props;
---

<MediaDetailContent media={media} />
