---
import MediaDetailContent from '../../../components/viewer/details/MediaDetailContent.astro';
import { mediaRepository } from '../../../features/media/api';

export const partial = true;

export async function getStaticPaths() {
  return (await mediaRepository.all()).map(media => ({ params: { mediaId: media.mediaId } }));
}

const { mediaId } = Astro.params;

if (!mediaId) {
  throw new Error('mediaId is required');
}

const media = await mediaRepository.get(mediaId);
---

<MediaDetailContent media={media} />
