---
import SongDetailContent from '../../../components/viewer/details/SongDetailContent.astro';
import { songRepository } from '../../../features/songs/api';

export const partial = true;

export async function getStaticPaths() {
  return (await songRepository.all()).map(song => ({ params: { songId: song.songId } }));
}

const { songId } = Astro.params;

if (!songId) {
  throw new Error('songId is required');
}

const song = await songRepository.get(songId);
---

<SongDetailContent song={song} />
