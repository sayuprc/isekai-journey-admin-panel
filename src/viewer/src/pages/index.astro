---
import JacketArt from '../components/viewer/JacketArt.astro';
import MVThumb from '../components/viewer/MVThumb.astro';
import PostCard from '../components/viewer/PostCard.astro';
import SectionHead from '../components/viewer/SectionHead.astro';
import { Q } from '../data/mock/site-data';
import { mediaTypeLabel } from '../features/media/labels';
import { latestMedia, latestPosts } from '../features/media/sort';
import { latestRelease } from '../features/releases/sort';
import { siteStatsRepository } from '../features/site-stats/api';
import Layout from '../layouts/Layout.astro';

const release = latestRelease();
const media = latestMedia(3);
const posts = latestPosts(3);
const siteStats = await siteStatsRepository.get();
---

<Layout pageTitle="Home">
  <section class="hero-data">
    <div class="shell hero-data-grid">
      <div class="hero-data-copy">
        <div class="hero-mark hero-mark-data"><span>ヰ世界</span><span>観測所</span></div>
        <div class="hero-en hero-en-whisper">Isekai Observatory</div>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/songs">楽曲を辿る →</a>
          {/* <a class="btn" href="/media">映像を観る</a> */}
        </div>
      </div>
      <div class="hero-data-stats">
        <div class="hero-data-stat hero-data-stat-row">
          <strong>{siteStats.songCount}</strong>
          <div class="hero-data-stat-copy">
            <span>楽曲</span>
            <em>songs</em>
          </div>
        </div>
        {/*
        <div class="hero-data-stat hero-data-stat-row">
          <strong>{SITE_DATA.releases.length}</strong>
          <div class="hero-data-stat-copy">
            <span>リリース</span>
            <em>releases</em>
          </div>
        </div>
        <div class="hero-data-stat hero-data-stat-row">
          <strong>{SITE_DATA.media.length}</strong>
          <div class="hero-data-stat-copy">
            <span>メディア</span>
            <em>media</em>
          </div>
        </div>
        */}
        <div class="hero-data-stat hero-data-stat-row">
          <strong>{new Date().getFullYear() - 2020}</strong>
          <div class="hero-data-stat-copy">
            <span>観測年</span>
            <em>since 2020</em>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/*
  <section class="shell">
    <SectionHead title="最新リリース" />
    {
      release && (
        <div class="feature-grid-link">
          <a href={`/releases/${release.id}`} class="feature-art-link">
            <JacketArt color={release.color} label={release.title} />
          </a>
          <div>
            <div class="eyebrow">{release.type} — {release.date}</div>
            <h3 class="feature-title">
              <a href={`/releases/${release.id}`}>{release.title}</a>
            </h3>
            <div class="label-mono">{release.format}</div>
            <p class="feature-summary">収録曲 · {Q.songsOfRelease(release.id).length} 曲</p>
            <div class="rel-list">
              {
                Q.songsOfRelease(release.id).slice(0, 5).map((song, index) => (
                  <a class="rel-chip" href={`/songs/${song.id}`}>
                    <span class="detail-index">{String(index + 1).padStart(2, '0')}</span>
                    <div class="rel-main">{song.title}</div>
                  </a>
                ))
              }
            </div>
          </div>
        </div>
      )
    }
  </section>

  <section class="shell">
    <SectionHead title="最新の映像">
      <a slot="right" class="btn" href="/media">すべての映像 →</a>
    </SectionHead>
    <div class="media-card-grid">
