---
import JacketArt from '../components/viewer/JacketArt.astro';
// import MVThumb from '../components/viewer/MVThumb.astro';
// import PostCard from '../components/viewer/PostCard.astro';
import SectionHead from '../components/viewer/SectionHead.astro';
import SongTile from '../components/viewer/SongTile.astro';
// import { Q } from '../data/mock/site-data';
// import { mediaTypeLabel } from '../features/media/labels';
// import { latestMedia, latestPosts } from '../features/media/sort';
import { releaseGroupContentRepository } from '../features/releases/content';
import { representativeJacketArtUrl } from '../features/releases/types';
import { siteStatsRepository } from '../features/site-stats/api';
import { songContentRepository } from '../features/songs/content';
import Layout from '../layouts/Layout.astro';

// 一覧は最古発売日の降順なので先頭が最新リリース。
const latestReleaseGroup = (await releaseGroupContentRepository.all())[0] ?? null;
const songs = (await songContentRepository.all());
const latestSong = songs[songs.length - 1] ?? null;
// const media = latestMedia(3);
// const posts = latestPosts(3);
const siteStats = await siteStatsRepository.get();

const observationYears = (() => {
  const OBSERVATION_START = new Date('2019-12-09');

  const now = new Date();

  let years = now.getFullYear() - OBSERVATION_START.getFullYear();

  const beforeAnniversary = now.getMonth() < OBSERVATION_START.getMonth()
    || (now.getMonth() === OBSERVATION_START.getMonth() && now.getDate() < OBSERVATION_START.getDate());

  if (beforeAnniversary) {
    years -= 1;
  }

  return years;
})();

---

<Layout pageTitle="">
  <section class="hero-data">
    <div class="shell">
      <div class="hero-mark hero-mark-data">ヰ世界観測所</div>
      <div class="hero-en hero-en-whisper">Isekai Observatory</div>
      <div class="hero-ledger">
        <div class="hero-ledger-row">
          <span class="hero-ledger-label">Observation Since</span>
          <span class="hero-ledger-leader"></span>
          <span class="hero-ledger-value">2019.12.09 <small>— {observationYears}TH YEAR</small></span>
        </div>
        <div class="hero-ledger-row">
          <span class="hero-ledger-label">Songs</span>
          <span class="hero-ledger-leader"></span>
          <span class="hero-ledger-value">{siteStats.songCount}</span>
        </div>
        <div class="hero-ledger-row">
          <span class="hero-ledger-label">Releases</span>
          <span class="hero-ledger-leader"></span>
          <span class="hero-ledger-value">{siteStats.releaseCount}</span>
        </div>
        {/*
        <div class="hero-ledger-row">
          <span class="hero-ledger-label">Media</span>
          <span class="hero-ledger-leader"></span>
          <span class="hero-ledger-value">{SITE_DATA.media.length}</span>
        </div>
        */}
      </div>
      {/*
      <div class="hero-actions">
        <a class="btn" href="/media">映像を観る</a>
      </div>
      */}
    </div>
  </section>

  {
    latestSong && (
      <section class="shell">
        <SectionHead title="最新楽曲" />
        <div class="feature-grid-link">
          <a href={`/songs/${latestSong.songId}`} class="feature-art-link">
            <SongTile
              songId={latestSong.songId}
              title={latestSong.title}
              mediaCount={latestSong.counts.mediaCount}
              index={0}
              media={latestSong.media}
              aspectRatio="1 / 1"
            />
          </a>
          <div class="feature-body">
            <div class="eyebrow">{latestSong.type.name}</div>
            <h3 class="feature-title">
              <a href={`/songs/${latestSong.songId}`}>{latestSong.title}</a>
            </h3>
            {latestSong.description && <p class="feature-summary">{latestSong.description}</p>}
            <a class="btn feature-more" href={`/songs/${latestSong.songId}`}>楽曲詳細 →</a>
          </div>
        </div>
      </section>
    )
  }

  {
    latestReleaseGroup && (
      <section class="shell">
        <SectionHead title="最新リリース" />
        <div class="feature-grid-link">
          <a href={`/releases/${latestReleaseGroup.releaseGroupId}`} class="feature-art-link">
            <JacketArt imageUrl={representativeJacketArtUrl(latestReleaseGroup)} label={latestReleaseGroup.title} />
          </a>
          <div class="feature-body">
            <div class="eyebrow">{latestReleaseGroup.type.name} — {latestReleaseGroup.firstReleasedOn}</div>
            <h3 class="feature-title">
              <a href={`/releases/${latestReleaseGroup.releaseGroupId}`}>{latestReleaseGroup.title}</a>
            </h3>
            <p class="feature-summary">収録曲</p>
            <div class="rel-list feature-track-list">
              {
                (latestReleaseGroup.releases[0]?.media.flatMap(medium => medium.tracks) ?? []).slice(0, 8).map(track => (
                  track.songId !== null && track.isDisplay
                    ? (
                        <a class="rel-chip" href={`/songs/${track.songId}`}>
                          <span class="detail-index">{String(track.trackNo).padStart(2, '0')}</span>
                          <div class="rel-main">{track.title}</div>
                        </a>
                      )
                    : (
                        <div class="rel-chip" aria-disabled="true">
                          <span class="detail-index">{String(track.trackNo).padStart(2, '0')}</span>
                          <div class="rel-main">{track.title}</div>
                        </div>
                      )
                ))
              }
            </div>
            <a class="btn feature-more" href={`/releases/${latestReleaseGroup.releaseGroupId}`}>リリース詳細 →</a>
          </div>
        </div>
      </section>
    )
  }

  {/*
  <section class="shell">
    <SectionHead title="最新の映像">
      <a slot="right" class="btn" href="/media">すべての映像 →</a>
    </SectionHead>
    <div class="media-card-grid">
      {
        media.map(entry => (
          <a href={`/media/${entry.id}`} class="media-card">
            <MVThumb color={entry.color} label={mediaTypeLabel(entry.type).toUpperCase()} />
            <div class="media-card-body">
              <div class="label-mono">{entry.date} · {entry.views} views</div>
              <div class="media-card-title">{entry.title}</div>
              <div class="media-card-tags">
                {Q.songsOfMedia(entry.id).map(song => <span class="pill">{song.title}</span>)}
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  {
    posts.length > 0 && (
      <section class="shell">
        <SectionHead title="最近の投稿">
          <a slot="right" class="btn" href="/media">すべての投稿 →</a>
        </SectionHead>
        <div class="recent-posts-grid">
          {posts.map(entry => <PostCard entry={entry} compact />)}
        </div>
      </section>
    )
  }
  */}
</Layout>
