---
import LayoutSwitcher from '../../components/viewer/LayoutSwitcher.astro';
import MVThumb from '../../components/viewer/MVThumb.astro';
import PostCard from '../../components/viewer/PostCard.astro';
import SectionHead from '../../components/viewer/SectionHead.astro';
import { Q, SITE_DATA, mediaTypeLabel } from '../../data/site-helpers';
import Layout from '../../layouts/Layout.astro';

const videoTypes = ['mv', 'live-clip', 'interview', 'short'];
const postTypes = ['tweet', 'instagram', 'youtube-community', 'blog'];
const entries = [...SITE_DATA.media].sort((a, b) => b.date.localeCompare(a.date));
const videos = entries.filter(entry => videoTypes.includes(entry.type));
const posts = entries.filter(entry => postTypes.includes(entry.type));
const featured = videos[0];
---

<Layout pageTitle="Media">
  <section class="shell page-section">
    <SectionHead num="—" title="メディア" titleEn={`Media / ${entries.length} entries`}>
      <LayoutSwitcher
        slot="right"
        name="media"
        initialValue="cinema"
        options={[
          { value: 'cinema', label: 'CINEMA' },
          { value: 'mosaic', label: 'MOSAIC' },
          { value: 'list', label: 'LIST' },
        ]}
      />
    </SectionHead>

    <div class="viewer-filters" data-media-controls>
      <button class="btn is-active" type="button" data-media-filter="all">すべて ({entries.length})</button>
      <button class="btn" type="button" data-media-filter="video">映像 ({videos.length})</button>
      <button class="btn" type="button" data-media-filter="post">SNS / 投稿 ({posts.length})</button>
      <button class="btn" type="button" data-media-filter="mv">MV</button>
      <button class="btn" type="button" data-media-filter="live-clip">ライブ切り抜き</button>
      <button class="btn" type="button" data-media-filter="interview">インタビュー</button>
      <button class="btn" type="button" data-media-filter="short">Short</button>
      <button class="btn" type="button" data-media-filter="tweet">X / Twitter</button>
      <button class="btn" type="button" data-media-filter="instagram">Instagram</button>
      <button class="btn" type="button" data-media-filter="youtube-community">YT コミュニティ</button>
      <button class="btn" type="button" data-media-filter="blog">ブログ</button>
    </div>

    <div data-layout-group="media">
      <div data-layout-panel="cinema">
        {
          featured && (
            <>
              <div
                class="media-featured-grid"
                data-media-entry
                data-media-type={featured.type}
                data-media-kind="video"
              >
                <a href={`/media/${featured.id}`}>
                  <MVThumb color={featured.color} label={`NOW PLAYING — ${mediaTypeLabel(featured.type).toUpperCase()}`} />
                </a>
                <div class="media-featured-copy">
                  <div class="label-mono">FEATURED · {featured.date}</div>
                  <h3 class="feature-title">{featured.title}</h3>
                  <div class="feature-subtitle">{mediaTypeLabel(featured.type)} · {featured.views} views</div>
                  <p class="feature-summary">{featured.description}</p>
                </div>
              </div>

              <div class="media-card-grid" data-media-layout-root="cinema-videos">
                {
                  videos.slice(1).map(entry => (
                    <a
                      href={`/media/${entry.id}`}
                      class="media-card"
                      data-media-entry
                      data-media-type={entry.type}
                      data-media-kind="video"
                    >
                      <MVThumb color={entry.color} label={mediaTypeLabel(entry.type).toUpperCase()} />
                      <div class="media-card-body">
                        <div class="label-mono">{entry.date} · {entry.views}</div>
                        <div class="media-card-title">{entry.title}</div>
                      </div>
                    </a>
                  ))
                }
              </div>

              {
                posts.length > 0 && (
                  <div class="recent-posts-grid media-posts-grid" data-media-layout-root="cinema-posts">
                    {
                      posts.map(entry => (
                        <div data-media-entry data-media-type={entry.type} data-media-kind="post">
                          <PostCard entry={entry} />
                        </div>
                      ))
                    }
                  </div>
                )
              }
            </>
          )
        }
      </div>

      <div data-layout-panel="mosaic" hidden>
        <div class="media-mosaic" data-media-layout-root="mosaic">
          {
            entries.map((entry, index) => (
              <a
                href={`/media/${entry.id}`}
                class={`media-mosaic-item media-mosaic-${['lg', 'sm', 'sm', 'md'][index % 4]}`}
                data-media-entry
                data-media-type={entry.type}
                data-media-kind={videoTypes.includes(entry.type) ? 'video' : 'post'}
              >
                <div class="media-mosaic-bg" style={`--tile-color:${entry.color};`}></div>
                <div class="media-mosaic-copy">
                  <div class="label-mono media-mosaic-label">{mediaTypeLabel(entry.type).toUpperCase()}</div>
                  <div class="label-mono">{entry.date}{entry.views ? ` · ${entry.views}` : ''}</div>
                  <div class="media-card-title">{entry.title ?? entry.text}</div>
                </div>
              </a>
            ))
          }
        </div>
      </div>

      <div data-layout-panel="list" hidden>
        <div class="media-list" data-media-layout-root="list">
          {
            entries.map((entry, index) => (
              <a
                href={`/media/${entry.id}`}
                class="media-list-row"
                data-media-entry
                data-media-type={entry.type}
                data-media-kind={videoTypes.includes(entry.type) ? 'video' : 'post'}
              >
                <span class="detail-index">{String(index + 1).padStart(2, '0')}</span>
                <div class="media-list-thumb">
                  <MVThumb color={entry.color} />
                </div>
                <div>
                  <div class="label-mono">{entry.date} · {mediaTypeLabel(entry.type)}{entry.views ? ` · ${entry.views}` : ''}</div>
                  <div class="media-card-title">{entry.title ?? entry.text}</div>
                  <div class="media-card-tags">
                    {Q.songsOfMedia(entry.id).map(song => <span class="pill">楽曲 · {song.title}</span>)}
                  </div>
                </div>
                <span>→</span>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</Layout>

<script is:inline>
  (() => {
    const initMediaFilters = () => {
      const root = document.querySelector('[data-media-controls]');
      if (!(root instanceof HTMLElement) || root.dataset.ready === 'true') return;
      const buttons = [...root.querySelectorAll('[data-media-filter]')];
      let filter = 'all';

      const getEntries = () => [
        ...document.querySelectorAll('[data-layout-panel="cinema"] [data-media-entry]'),
        ...document.querySelectorAll('[data-media-layout-root="mosaic"] [data-media-entry]'),
        ...document.querySelectorAll('[data-media-layout-root="list"] [data-media-entry]'),
      ];

      const matches = (entry) => {
        if (!(entry instanceof HTMLElement)) return false;
        const type = entry.dataset.mediaType || '';
        const kind = entry.dataset.mediaKind || '';
        if (filter === 'all') return true;
        if (filter === 'video' || filter === 'post') return kind === filter;
        return type === filter;
      };

      const apply = () => {
        for (const entry of getEntries()) {
          if (!(entry instanceof HTMLElement)) continue;
          entry.style.display = matches(entry) ? '' : 'none';
        }
      };

      for (const button of buttons) {
        if (!(button instanceof HTMLButtonElement)) continue;
        button.addEventListener('click', () => {
          filter = button.dataset.mediaFilter || 'all';
          for (const other of buttons) {
            if (other instanceof HTMLElement) other.classList.toggle('is-active', other === button);
          }
          apply();
        });
      }

      apply();
      root.dataset.ready = 'true';
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initMediaFilters, { once: true });
    } else {
      initMediaFilters();
    }
  })();
</script>
