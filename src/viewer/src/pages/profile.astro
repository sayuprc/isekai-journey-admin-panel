---
import SectionHead from '../components/viewer/SectionHead.astro';
import { SITE_DATA } from '../data/site-helpers';
import Layout from '../layouts/Layout.astro';
---

<Layout pageTitle="Profile">
  <section class="shell page-section">
    <SectionHead num="—" title="人物録" titleEn="Profile / About" />
    <div class="profile-grid">
      <div>
        <div class="profile-portrait"></div>
        <div class="profile-portrait-meta">
          <span>FIG. PORTRAIT</span>
          <span>{SITE_DATA.artist.debut}—</span>
        </div>
      </div>
      <div>
        <div class="eyebrow">SINGER · VIRTUAL</div>
        <h1 class="detail-title">{SITE_DATA.artist.name}</h1>
        <div class="detail-title-en">{SITE_DATA.artist.nameEn}</div>
        <div class="detail-meta-grid">
          <div><span class="label-mono">DEBUT</span><strong>{SITE_DATA.artist.debut}</strong></div>
          <div><span class="label-mono">SONGS</span><strong>{SITE_DATA.songs.length}+ tracks</strong></div>
          <div><span class="label-mono">MUSIC VIDEOS</span><strong>{SITE_DATA.media.filter(entry => entry.type === 'mv').length}+ films</strong></div>
          <div><span class="label-mono">EVENTS</span><strong>{SITE_DATA.events.length}+ appearances</strong></div>
        </div>
        <p class="detail-description">
          {SITE_DATA.artist.tagline}。夜と詩の間にあるような声で歌うアーティストとして、静謐で物語性のある歌世界を編む。
        </p>
        <div class="hero-actions">
          <a class="btn" href="#">YouTube ↗</a>
          <a class="btn" href="#">Twitter / X ↗</a>
          <a class="btn" href="#">Streaming ↗</a>
          <a class="btn" href="#">Official ↗</a>
        </div>
      </div>
    </div>

    <SectionHead num="01" title="軌跡" titleEn="Chronology" />
    <div class="chronology-grid">
      <div>2020</div><div>活動開始 / デビュー</div>
      <div>2021</div><div>初のシングル多数リリース、配信ライブ複数回</div>
      <div>2022</div><div>初アルバム『残響アーカイブ』リリース、初ワンマンライブ</div>
      <div>2023</div><div>シリーズ公演「幻奏夜会」開始、海外配信</div>
      <div>2024</div><div>大型フェス出演、メディア露出増、新作続々</div>
      <div>2025</div><div>Spring Voyage 2025 開催予定</div>
    </div>
  </section>
</Layout>
