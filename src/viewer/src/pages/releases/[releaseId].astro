---
import ReleaseDetailContent from '../../components/viewer/details/ReleaseDetailContent.astro';
import { SITE_DATA } from '../../data/site-helpers';
import Layout from '../../layouts/Layout.astro';

export function getStaticPaths() {
  return SITE_DATA.releases.map(release => ({
    params: { releaseId: release.id },
    props: { release },
  }));
}

const { release } = Astro.props;
---

<Layout pageTitle={release.title}>
  <section class="shell page-section detail-page">
    <ReleaseDetailContent release={release} />
  </section>
</Layout>
