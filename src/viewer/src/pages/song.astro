---
import Layout from '../layouts/Layout.astro';
---

<Layout pageTitle="楽曲">
  <section class="shell page-section">
    <div class="event-hero">
      <div class="eyebrow">Legacy Route</div>
      <h1 class="detail-title">楽曲一覧</h1>
      <p class="detail-description">
        旧 `/song` ルートは `/songs` へ役割を移しました。
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/songs">Songs へ移動</a>
      </div>
    </div>
  </section>
</Layout>
