---
import SongDetailContent from '../../components/viewer/details/SongDetailContent.astro';
import { songRepository } from '../../features/songs/api';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  return (await songRepository.list()).map(song => ({ params: { songId: song.songId } }));
}

const { songId } = Astro.params;

