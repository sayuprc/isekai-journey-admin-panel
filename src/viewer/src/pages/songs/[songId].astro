---
import SongDetailContent from '../../components/viewer/details/SongDetailContent.astro';
import { songContentRepository } from '../../features/songs/content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  return (await songContentRepository.all()).map(song => ({
    params: { songId: song.songId },
    props: { song },
  }));
}

const { song } = Astro.props;

const pageDescription = song.description || `ヰ世界情緒の楽曲「${song.title}」の情報`;
const ogImageUrl = song.releaseGroups.find(releaseGroup => releaseGroup.jacketArtUrl !== null)?.jacketArtUrl ?? null;
---

<Layout pageTitle={song.title} pageDescription={pageDescription} ogImageUrl={ogImageUrl}>
  <section class="shell page-section detail-page">
    <SongDetailContent song={song} />
  </section>
</Layout>
