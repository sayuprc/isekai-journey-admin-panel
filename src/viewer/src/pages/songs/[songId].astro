---
import SongDetailContent from '../../components/viewer/details/SongDetailContent.astro';
import { songRepository } from '../../features/songs/api';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  return Promise.all(
    (await songRepository.all()).map(async song => ({
      params: { songId: song.songId },
      props: { song: await songRepository.get(song.songId) },
    }))
  )
}

const { song } = Astro.props;
---

<Layout pageTitle={song.title}>
  <section class="shell page-section detail-page">
    <SongDetailContent song={song} />
  </section>
</Layout>
