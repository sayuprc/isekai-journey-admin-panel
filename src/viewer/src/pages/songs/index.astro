---
import FilterBar from '../../components/viewer/FilterBar';
import JacketArt from '../../components/viewer/JacketArt.astro';
import LayoutSwitcher from '../../components/viewer/LayoutSwitcher';
import SectionHead from '../../components/viewer/SectionHead.astro';
import { Q, SITE_DATA } from '../../data/mock/site-data';
import Layout from '../../layouts/Layout.astro';

const songs = SITE_DATA.songs;
---

<Layout pageTitle="楽曲">
  <section class="shell page-section">
    <SectionHead num="—" title="楽曲" titleEn={`Songs / ${songs.length} songs`}>
      <LayoutSwitcher
        client:load
        slot="right"
        name="songs"
        initialValue="grid"
        options={[
          { value: 'grid', label: 'GRID' },
          { value: 'table', label: 'TABLE' },
          { value: 'card', label: 'CARD' },
        ]}
      />
    </SectionHead>

    <FilterBar
      client:load
      filters={[
        { value: 'all', label: `すべて (${songs.length})` },
        { value: 'original', label: 'オリジナル' },
        { value: 'cover', label: 'カバー' },
      ]}
      entrySelector="[data-song-entry]"
      categoryAttrs={['songCategory']}
      searchAttr="songSearch"
      searchPlaceholder="タイトル・読み・クレジットを検索..."
    />

    <div data-layout-group="songs">
      <div data-layout-panel="grid">
        <div class="song-grid">
          {
            songs.map(song => {
              const stats = Q.songStats(song.id);
              return (
                <a
                  href={`/songs/${song.id}`}
                  class="song-grid-card"
                  data-song-entry
                  data-song-category={song.category === 'オリジナル' ? 'original' : 'cover'}
                  data-song-search={`${song.title} ${song.lyricist} ${song.composer} ${song.description}`.toLowerCase()}
                >
                  <JacketArt color={song.color} label={song.title} />
                  <div class="song-grid-body">
                    <div class="song-grid-meta">
                      <span class="pill">{song.category}</span>
                      <div class="song-meta-inline">
                        <span>{stats.releases} rel</span>
                        <span>{stats.performances} live</span>
                        <span>{stats.media} mv</span>
                      </div>
                    </div>
                    <div class="song-grid-title">{song.title}</div>
                  </div>
                </a>
              );
            })
          }
        </div>
      </div>

      <div data-layout-panel="table" hidden>
        <div class="songs-table">
          <div class="tbl-row tbl-head">
            <div class="label-mono">#</div>
            <div class="label-mono">TITLE</div>
            <div class="label-mono">CAT.</div>
            <div class="label-mono">REL</div>
            <div class="label-mono">LIVE</div>
            <div class="label-mono">MV</div>
          </div>
          {
            songs.map((song, index) => {
              const stats = Q.songStats(song.id);
              return (
                <a
                  href={`/songs/${song.id}`}
                  class="tbl-row tbl-body"
                  data-song-entry
                  data-song-category={song.category === 'オリジナル' ? 'original' : 'cover'}
                  data-song-search={`${song.title} ${song.lyricist} ${song.composer} ${song.description}`.toLowerCase()}
                >
                  <span class="detail-index">{String(index + 1).padStart(2, '0')}</span>
                  <div>
                    <div class="table-title">{song.title}</div>
                  </div>
                  <span class="pill">{song.category}</span>
                  <span class="num-cell">{stats.releases}</span>
                  <span class="num-cell">{stats.performances}</span>
                  <span class="num-cell">{stats.media}</span>
                </a>
              );
            })
          }
        </div>
      </div>

      <div data-layout-panel="card" hidden>
        <div class="songs-card-grid">
          {
            songs.map(song => {
              const stats = Q.songStats(song.id);
              return (
                <a
                  href={`/songs/${song.id}`}
                  class="song-card"
                  data-song-entry
                  data-song-category={song.category === 'オリジナル' ? 'original' : 'cover'}
                  data-song-search={`${song.title} ${song.lyricist} ${song.composer} ${song.description}`.toLowerCase()}
                >
                  <JacketArt color={song.color} label={song.id} />
                  <div class="song-card-body">
                    <div class="label-mono">{song.category}</div>
                    <div class="timeline-title">{song.title}</div>
                    <p class="song-grid-description">{song.description}</p>
                    <div class="song-card-stats">
                      <div><span class="detail-index">{stats.releases}</span><span class="label-mono">releases</span></div>
                      <div><span class="detail-index">{stats.performances}</span><span class="label-mono">歌唱</span></div>
                      <div><span class="detail-index">{stats.media}</span><span class="label-mono">media</span></div>
                    </div>
                  </div>
                </a>
              );
            })
          }
        </div>
      </div>
    </div>
  </section>
</Layout>
